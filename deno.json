{
  "imports": {
    "hono": "jsr:@hono/hono@^4",
    "@std/assert": "jsr:@std/assert@^1"
  },
  "tasks": {
    "start": "deno run --allow-net --allow-env --allow-read --allow-write src/server.ts",
    "dev": "deno run --watch --allow-net --allow-env --allow-read --allow-write src/server.ts",
    "test": "deno test --allow-net --allow-env --allow-read --allow-write test/",
    "check": "deno check src/server.ts src/sqlite.ts tools/healthcheck.ts",
    "healthcheck": "deno run --no-config --allow-net --allow-env tools/healthcheck.ts"
  },
  "test": {
    "include": ["test/"]
  },
  "fmt": {
    "exclude": ["data/"]
  },
  "lint": {
    "exclude": ["data/"]
  }
}
