# For local development (supabase start provides these automatically)
# For production, set these in Supabase Dashboard > Edge Functions > Secrets

# Database URL (automatically available in Supabase Edge Functions)
# SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Alternatively, if self-hosting or using external Postgres:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
