# ============================================================================
# UGS Metadata Server —— 环境变量示例
#
# 用法：复制成 .env 后按需修改（.env 已被 .gitignore 忽略）
#   cp .env.example .env
#
# 进程真实环境变量优先级高于本文件，因此 Docker / CI 里直接注入环境变量即可。
# ============================================================================


# ---------------------------------------------------------------------------
# 数据库驱动选择
# ---------------------------------------------------------------------------
# sqlite   = 纯本地单文件数据库（默认，零外部依赖）
# postgres = Supabase / 自建 PostgreSQL
#
# 不设置时的自动判断规则：
#   存在 SUPABASE_DB_URL 或 DATABASE_URL → postgres
#   其余情况                            → sqlite
DB_DRIVER=sqlite


# ---------------------------------------------------------------------------
# 纯本地 SQLite 模式
# ---------------------------------------------------------------------------
# 数据库文件路径，父目录不存在会自动创建。
# 相对路径基于进程工作目录；Docker 里建议用绝对路径（如 /data/ugs.db）。
SQLITE_PATH=./data/ugs.db


# ---------------------------------------------------------------------------
# PostgreSQL 模式（二选一，Supabase 部署时由平台自动注入 SUPABASE_DB_URL）
# ---------------------------------------------------------------------------
# Supabase 本地开发 / 生产：
# SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# 自建 PostgreSQL：
# DATABASE_URL=postgresql://user:password@host:5432/dbname


# ---------------------------------------------------------------------------
# HTTP 服务（本地入口 serve.ts，以及 Docker 容器）
# ---------------------------------------------------------------------------
# 监听端口
PORT=8080

# 监听地址。Docker 里必须是 0.0.0.0；只想本机访问可改成 127.0.0.1
HOST=0.0.0.0

# 路由前缀。本地模式留空，UGS 客户端即可直接访问 http://<host>:8080/api/...
# 只有当你想把服务挂在子路径下（例如反向代理到 /ugs）时才需要设置。
BASE_PATH=
